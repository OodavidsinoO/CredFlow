# NESSUS_SECRET_KEY=your_secret_key

# Scan Template (optional — auto-discovered by name; also from JS as fallback)
SCAN_TEMPLATE_NAME=basic
SCAN_TEMPLATE_UUID=

# DB export password (auto-generated if empty)
DB_PASSWORD=

# ── Nessus Connection ──────────────────────────────────────────
# X-API-Version: 2 is sent automatically (required since Nessus 19.x
# for plugin-family control to work).
NESSUS_URL=https://192.168.1.195:8834
NESSUS_USERNAME=your_nessus_username
NESSUS_PASSWORD=your_nessus_password
NESSUS_API_TOKEN=
NESSUS_SSL_VERIFY=false

# Nessus API Keys (fallback, not required when username/password set)
# NESSUS_ACCESS_KEY=your_access_key
# NESSUS_SECRET_KEY=your_secret_key

# ── Primary: Source Scan (recommended — 90% of use cases) ──────
# Clones template + plugin families + scalar settings (e.g. max_checks_per_host)
# + naming from an existing Nessus scan. Sensitive settings (SMTP, HTTP headers)
# are NOT inherited.
# Uncomment and set to your pre-configured scan name.
SOURCE_SCAN_NAME=Ubuntu-AdvancedScan

# ── Fallback: Manual Template Selection ────────────────────────
# Only used when SOURCE_SCAN_NAME is empty or not found.
SCAN_TEMPLATE_NAME=advanced
SCAN_TEMPLATE_UUID=

# ── Overrides (optional) ───────────────────────────────────────
# Extra plugin families to disable on top of source scan settings.
# Comma-separated, substring-matched against template families.
# DISABLED_PLUGIN_FAMILIES=Web Crawler,Brute Force Attacks

# Custom scan name prefix. Defaults to source scan name, or "CredFlow".
# SCAN_NAME_PREFIX=ProdScan

# ── DB export password (auto-generated if empty) ───────────────
DB_PASSWORD=

# ── Execution Tuning ───────────────────────────────────────────
# CREDFLOW_MAX_WORKERS=1        # parallel workers (1-5)
# CREDFLOW_MAX_RETRIES=1        # retry attempts per target
# CREDFLOW_POLL_INTERVAL=30     # seconds between status checks
# CREDFLOW_POLL_TIMEOUT=3600    # max seconds per scan
# CREDFLOW_BATCH_TIMEOUT=0      # max wall-clock seconds for entire batch (0=no limit)
# CREDFLOW_RESUME=true           # resume from state DB (false = fresh start)
# CREDFLOW_PERMANENT_DELETE=false  # permanently delete scans (default: move to Trash)
# CREDFLOW_REPORTS_DIR=./reports
# CREDFLOW_STATE_DB=credflow_state.db
